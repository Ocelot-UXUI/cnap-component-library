{
  "name": "@baidu/comate-stack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn gen:ai-context && vite build",
    "preview": "vite preview",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint-type": "tsc",
    "test": "vitest run",
    "start": "vite",
    "prepare": "husky",
    "gen:ai-context": "node --experimental-strip-types scripts/generate-ai-context.ts",
    "verify:router-paths": "npx tsx scripts/verify-router-paths.ts",
    "verify:component-styles": "npx tsx scripts/verify-component-styles.ts",
    "verify:design-tokens": "npx tsx scripts/verify-design-tokens.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/x": "2.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@uiw/react-codemirror": "^4.25.11",
    "@xstate/react": "^6.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "^6.3.2",
    "axios": "^1.7.9",
    "axios-interface": "^2.1.1",
    "constate": "^4.0.0",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.38.0",
    "huse": "^2.0.4",
    "liquid-glass-react": "^1.1.1",
    "lodash": "^4.17.21",
    "qs": "^6.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^5.0.0",
    "react-router-dom": "^7.1.3",
    "three": "^0.184.0",
    "xstate": "^5.32.3"
  },
  "devDependencies": {
    "@tiny-codes/vite-plugin-qiankun": "^2.4.0",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.7",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.4",
    "dprint": "^0.54.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "7.37.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-route-links": "file:./eslint-plugin-route-links",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.8",
    "rolldown": "~1.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "^8.1.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "22.12.0",
    "yarn": "4.13.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md}": "dprint fmt"
  }
}
